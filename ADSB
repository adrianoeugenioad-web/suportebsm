<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ADSB Mobile v4</title>
<style>
:root{--n:#061a35;--n2:#0b2f5a;--g:#e6b64b;--bg:#eef3f8;--ok:#067647;--no:#b42318}
*{box-sizing:border-box}body{margin:0;font-family:Arial;background:var(--bg);color:#172033}button,input,select,textarea{font:inherit}.hidden{display:none!important}
.login{min-height:100vh;background:linear-gradient(#03152f55,#03152fee 72%),url('data:image/jpeg;base64,') center/cover;padding:18px;display:flex;justify-content:center}
.loginbox{width:min(430px,100%);text-align:center;color:#fff}.logo{font:700 56px Georgia;color:#f5cc68}.sub{letter-spacing:3px}.hero{height:300px;border-radius:22px;overflow:hidden;margin-top:15px;position:relative}.hero img{width:100%;height:100%;object-fit:cover;object-position:center 28%}.hero:after{content:"";position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#03152f)}
.leaders{position:relative;margin-top:-75px}.leaders small{color:#f5cc68}.leaders h2,.leaders h3{font-family:Georgia;margin:4px}.leaders h3{color:#f5cc68}
.avatar{width:82px;height:82px;border-radius:50%;overflow:hidden;border:4px solid #f5cc68;margin:14px auto}.avatar img{width:100%;height:100%;object-fit:cover}
.loginform{background:#031a38dd;padding:15px;border:1px solid #e6b64b;border-radius:18px}.loginform input{width:100%;padding:15px;margin:6px 0;border-radius:12px;border:1px solid #e6b64b88;background:#0a2b53;color:#fff}.loginform button,.primary{background:linear-gradient(90deg,#d99c2a,#f4cf70);color:#061a35;border:0;border-radius:11px;padding:12px;font-weight:900}.loginform button{width:100%;margin-top:8px}
.top{position:sticky;top:0;background:linear-gradient(110deg,var(--n),var(--n2));color:#fff;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;z-index:20}.brand{display:flex;gap:10px;align-items:center}.brand img{width:44px;height:44px;border-radius:50%;border:2px solid var(--g)}.brand b{color:#f5cc68;font-size:21px}.top button{background:#ffffff18;color:#fff;border:1px solid #ffffff44;border-radius:9px;padding:8px 11px}
main{max-width:950px;margin:auto;padding:16px 16px 85px}.page{display:none}.page.active{display:block}.welcome{background:linear-gradient(135deg,#174a80,#061a35);color:#fff;border-radius:17px;padding:18px}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:13px 0}.stat,.card,.panel{background:#fff;border-radius:15px;padding:14px;box-shadow:0 4px 15px #00152f14}.stat{border-top:3px solid var(--g)}.stat strong{display:block;font-size:28px;color:var(--n)}
.head{display:flex;justify-content:space-between;align-items:center;gap:9px;margin-bottom:12px}.head h2{margin:0;color:var(--n)}.cards{display:grid;gap:10px}.card{border-left:4px solid var(--g)}.card h3{margin:0 0 6px;color:var(--n)}.card p{margin:4px 0;color:#667085}
.secondary,.danger,.approve,.reject,.mini{border:0;border-radius:9px;padding:9px 11px;font-weight:800}.secondary,.mini{background:#e8eef5;color:var(--n)}.danger,.reject{background:#fee4e2;color:var(--no)}.approve{background:#dcfae6;color:var(--ok)}
.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.status{display:inline-block;padding:5px 8px;border-radius:999px;font-size:12px;font-weight:800}.pending{background:#fff0c2;color:#b54708}.approved{background:#dcfae6;color:var(--ok)}.rejected{background:#fee4e2;color:var(--no)}
.person{border:1px solid #dce4ed;border-radius:11px;padding:10px;margin:8px 0}.person h4{margin:0;color:var(--n)}.finance{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.finance div{background:#f4f7fb;padding:9px;border-radius:9px}.finance strong{display:block}
.bottom{position:fixed;bottom:0;left:0;right:0;height:67px;background:#fff;border-top:1px solid #dce3eb;display:grid;grid-template-columns:repeat(6,1fr)}.bottom button{border:0;background:#fff;font-size:10px;color:#667085}.bottom button.active{color:var(--n);border-top:3px solid var(--g)}
dialog{border:0;border-radius:17px;padding:0;width:min(96vw,680px)}dialog::backdrop{background:#00152faa}.form{padding:16px;max-height:88vh;overflow:auto}.formhead{display:flex;justify-content:space-between;align-items:center}.formhead h3{margin:0}.x{border:0;border-radius:50%;width:36px;height:36px;font-size:21px}
label{display:block;font-size:13px;font-weight:700;margin-top:10px}label input,label select,label textarea{width:100%;padding:11px;margin-top:4px;border:1px solid #d4dde7;border-radius:9px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.formactions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}.draft{background:#f8fafc;border:1px dashed #cbd5e1;border-radius:10px;padding:9px;margin-top:9px}.empty{text-align:center;color:#667085;padding:20px}.toast{position:fixed;top:15px;left:50%;transform:translateX(-50%);background:#101828;color:white;padding:10px 14px;border-radius:9px;display:none;z-index:99}
@media(min-width:700px){.stats{grid-template-columns:repeat(4,1fr)}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:430px){.grid2{grid-template-columns:1fr}}
</style></head>
<body>
<div id="toast" class="toast"></div>
<section id="login" class="login"><div class="loginbox">
<div class="logo">ADSB</div><div class="sub">GESTÃO MINISTERIAL</div><p style="color:#f5cc68">REGIONAL SÃO BENEDITO</p>
<div class="hero"><img src="data:image/jpeg;base64,"></div><div class="leaders"><small>PASTOR REGIONAL</small><h2>Pr. Ariel Eugênio</h2><h3>e Irmã Eunice</h3></div>
<div class="avatar"><img src="data:image/jpeg;base64,"></div>
<form id="loginForm" class="loginform"><input id="lu" placeholder="Usuário" required><input id="lp" type="password" placeholder="Senha" required><button>ENTRAR →</button><small>Acesso inicial: Ariel / 2101</small></form>
</div></section>

<div id="app" class="hidden">
<header class="top"><div class="brand"><img src="data:image/jpeg;base64,"><div><b>ADSB</b><small>Regional São Benedito</small></div></div><button id="logout">Sair</button></header>
<main>
<section id="home" class="page active"><div class="welcome"><h2 id="welcome">Bem-vindo!</h2><p id="access"></p></div><div class="stats">
<div class="stat"><small>Congregações</small><strong id="sc">0</strong></div><div class="stat"><small>Festividades</small><strong id="sf">0</strong></div><div class="stat"><small>Pendentes</small><strong id="sp">0</strong></div><div class="stat"><small>Obreiros</small><strong id="sw">0</strong></div></div><div class="panel"><h3>🎂 Aniversariantes da Semana</h3><div id="birthWeek"></div></div><div class="panel"><h3>Próximas festividades</h3><div id="next"></div></div></section>

<section id="fest" class="page"><div class="head"><h2>Festividades</h2><button id="newFest" class="primary">+ Nova</button></div><div id="festList" class="cards"></div></section>
<section id="approve" class="page"><div class="head"><h2>Aprovações</h2></div><div id="approveList" class="cards"></div></section>
<section id="congs" class="page"><div class="head"><h2>Congregações</h2><button id="newCong" class="primary">+ Nova</button></div><div id="congList" class="cards"></div></section>
<section id="workers" class="page"><div class="head"><h2>Obreiros</h2><button id="newWorker" class="primary">+ Novo</button></div><div id="workerList" class="cards"></div></section>
<section id="users" class="page"><div class="head"><h2>Usuários</h2><button id="newUser" class="primary">+ Novo</button></div><div id="userList" class="cards"></div></section>
<section id="more" class="page"><div class="panel"><button id="backup" class="secondary" style="width:100%">Baixar backup</button><button id="reset" class="danger" style="width:100%;margin-top:10px">Limpar dados</button></div></section>
</main>
<nav class="bottom"><button data-page="home" class="active">⌂<br>Início</button><button data-page="fest">★<br>Festas</button><button id="approveNav" data-page="approve">✓<br>Aprovar</button><button data-page="workers">♟<br>Obreiros</button><button data-page="congs">⌂<br>Igrejas</button><button data-page="more">☰<br>Mais</button></nav>
</div>

<dialog id="congDlg"><form id="congForm" class="form"><div class="formhead"><h3>Congregação</h3><button type="button" class="x" data-close="congDlg">×</button></div>
<input type="hidden" id="cid"><label>Nome<input id="cname" required></label><label>Endereço<input id="caddress"></label><div class="grid2"><label>Pastor<input id="cpastor"></label><label>2º Dirigente<input id="csecond"></label></div><div class="grid2"><label>Telefone 1<input id="cphone1"></label><label>Telefone 2<input id="cphone2"></label></div><label>Instagram<input id="cinstagram"></label><div class="formactions"><button type="button" class="secondary" data-close="congDlg">Cancelar</button><button class="primary">Salvar</button></div></form></dialog>

<dialog id="festDlg"><form id="festForm" class="form"><input type="hidden" id="fid"><div class="formhead"><h3>Solicitação de Festividade</h3><button type="button" class="x" data-close="festDlg">×</button></div>
<label>Congregação<select id="fcong" required></select></label><label>Nome da festa<input id="fname" required></label><div class="grid2"><label>Data inicial<input id="fstart" type="date" required></label><label>Data final<input id="fend" type="date" required></label></div><label>Tema<input id="ftheme"></label>
<h4>Adicionar cantor ou pregador</h4><div class="grid2"><label>Tipo<select id="gtype"><option>Cantor</option><option>Pregador</option></select></label><label>Nome<input id="gname"></label></div><div class="grid2"><label>Denominação<input id="gden"></label><label>Igreja/Cidade<input id="gchurch"></label></div>
<div class="grid2"><label>Valor cobrado<input id="gfee" placeholder="0,00"></label><label>Transporte<input id="gtransport" placeholder="0,00"></label></div><div class="grid2"><label>Hospedagem<input id="ghotel" placeholder="0,00"></label><label>Alimentação<input id="gfood" placeholder="0,00"></label></div><button type="button" id="addGuest" class="secondary" style="margin-top:10px">+ Adicionar convidado</button><div id="guestDraft" class="draft"></div>
<h4>Outros gastos da congregação</h4><div class="grid2"><label>Decoração<input id="decoration" placeholder="0,00"></label><label>Sonorização<input id="sound" placeholder="0,00"></label></div><div class="grid2"><label>Alimentação geral<input id="food" placeholder="0,00"></label><label>Divulgação<input id="ads" placeholder="0,00"></label></div><div class="grid2"><label>Brindes<input id="gifts" placeholder="0,00"></label><label>Outros<input id="other" placeholder="0,00"></label></div>
<div class="formactions"><button type="button" class="secondary" data-close="festDlg">Cancelar</button><button class="primary">Enviar para aprovação</button></div></form></dialog>

<dialog id="workerDlg"><form id="workerForm" class="form"><input type="hidden" id="wid"><div class="formhead"><h3>Obreiro</h3><button type="button" class="x" data-close="workerDlg">×</button></div><label>Nome<input id="wname" required></label><div class="grid2"><label>Cargo<select id="wrole"><option>Pastor</option><option>Evangelista</option><option>Presbítero</option><option>Diácono</option><option>Cooperador</option></select></label><label>Congregação<select id="wcong"></select></label></div><div class="grid2"><label>Telefone<input id="wphone"></label><label>Data de nascimento<input id="wbirth" type="date"></label></div><div class="formactions"><button type="button" class="secondary" data-close="workerDlg">Cancelar</button><button class="primary">Salvar</button></div></form></dialog>

<dialog id="userDlg"><form id="userForm" class="form"><div class="formhead"><h3>Usuário</h3><button type="button" class="x" data-close="userDlg">×</button></div><label>Nome<input id="uname" required></label><label>Login<input id="ulogin" required></label><label>Senha<input id="upass" required></label><label>Perfil<select id="uprofile"><option value="congregacao">Congregação</option><option value="admin">Administrador</option></select></label><label>Congregação<select id="ucong"></select></label><div class="formactions"><button type="button" class="secondary" data-close="userDlg">Cancelar</button><button class="primary">Salvar</button></div></form></dialog>

<script>
const K='adsb_v4_final';
const initial={congregations:[],festivities:[],workers:[],users:[{id:'u1',name:'Pastor Ariel',login:'Ariel',password:'2101',profile:'admin',congregationId:''}]};
let data=JSON.parse(localStorage.getItem(K)||'null')||initial,current=null,guests=[];
const $=x=>document.getElementById(x),save=()=>localStorage.setItem(K,JSON.stringify(data)),id=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
function toast(t){$('toast').textContent=t;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',2000)}
function n(v){return Number(String(v||'0').replace(/\./g,'').replace(',','.'))||0}function money(v){return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}function fmt(d){return d?d.split('-').reverse().join('/'):''}
function allowedC(){return current.profile==='admin'?data.congregations:data.congregations.filter(c=>c.id===current.congregationId)}function allowedF(){return current.profile==='admin'?data.festivities:data.festivities.filter(f=>f.congregationId===current.congregationId)}
function cname(i){return data.congregations.find(c=>c.id===i)?.name||'Sem congregação'}function st(s){return s==='approved'?'Aprovada':s==='rejected'?'Reprovada':'Aguardando'}function sc(s){return s==='approved'?'approved':s==='rejected'?'rejected':'pending'}
function gt(g){return n(g.fee)+n(g.transport)+n(g.hotel)+n(g.food)}function ot(c){return n(c.decoration)+n(c.sound)+n(c.food)+n(c.ads)+n(c.gifts)+n(c.other)}function total(f){return f.guests.reduce((s,g)=>s+gt(g),0)+ot(f.costs)}function approvedTotal(f){return f.guests.filter(g=>g.status==='approved').reduce((s,g)=>s+gt(g),0)+ot(f.costs)}
$('loginForm').onsubmit=e=>{e.preventDefault();let u=data.users.find(x=>x.login.toLowerCase()===$('lu').value.trim().toLowerCase()&&x.password===$('lp').value);if(!u)return toast('Usuário ou senha inválidos');current=u;$('login').classList.add('hidden');$('app').classList.remove('hidden');render()}
$('logout').onclick=()=>location.reload();document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$(b.dataset.close).close());document.querySelectorAll('.bottom button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.bottom button').forEach(x=>x.classList.remove('active'));$(b.dataset.page).classList.add('active');b.classList.add('active')})
function fill(sel){sel.innerHTML='<option value="">Selecione...</option>'+allowedC().map(c=>`<option value="${c.id}">${c.name}</option>`).join('')}

function nextBirthdayInfo(birth){
 if(!birth)return null;
 let [y,m,d]=birth.split('-').map(Number),today=new Date(),year=today.getFullYear();
 let next=new Date(year,m-1,d);
 let start=new Date(today.getFullYear(),today.getMonth(),today.getDate());
 if(next<start)next=new Date(year+1,m-1,d);
 let diff=Math.round((next-start)/86400000);
 return {date:next,diff};
}
function renderBirthWeek(){
 let ws=current.profile==='admin'?data.workers:data.workers.filter(w=>w.congregationId===current.congregationId);
 let arr=ws.map(w=>({w,info:nextBirthdayInfo(w.birth)})).filter(x=>x.info&&x.info.diff>=0&&x.info.diff<=6).sort((a,b)=>a.info.diff-b.info.diff);
 $('birthWeek').innerHTML=arr.length?arr.map(x=>`<div class="person"><h4>🎉 ${x.info.diff===0?'Hoje':x.info.diff===1?'Amanhã':'Em '+x.info.diff+' dias'} — ${x.w.name}</h4><p>${x.w.role} • ${cname(x.w.congregationId)} • ${String(x.info.date.getDate()).padStart(2,'0')}/${String(x.info.date.getMonth()+1).padStart(2,'0')}</p></div>`).join(''):'<div class="empty">Nenhum aniversariante nos próximos 7 dias.</div>';
}
function render(){$('welcome').textContent='Bem-vindo(a), '+current.name+'!';$('access').textContent=current.profile==='admin'?'Administrador geral — acesso total':'Acesso à sua congregação';$('sc').textContent=allowedC().length;$('sf').textContent=allowedF().length;$('sp').textContent=allowedF().filter(f=>f.status==='pending').length;$('sw').textContent=(current.profile==='admin'?data.workers:data.workers.filter(w=>w.congregationId===current.congregationId)).length;$('approveNav').style.display=current.profile==='admin'?'':'none';renderC();renderF();renderA();renderW();renderU();renderBirthWeek();let ups=allowedF().slice().sort((a,b)=>a.start.localeCompare(b.start)).slice(0,5);$('next').innerHTML=ups.length?ups.map(f=>`<div class="person"><b>${fmt(f.start)} a ${fmt(f.end)} — ${f.name}</b><p>${cname(f.congregationId)} • <span class="status ${sc(f.status)}">${st(f.status)}</span></p></div>`).join(''):'<div class="empty">Nenhuma festividade.</div>'}
function renderC(){$('congList').innerHTML=allowedC().length?allowedC().map(c=>`<article class="card"><h3>${c.name}</h3><p>${c.address||'-'}</p><p>Pastor: ${c.pastor||'-'} | 2º Dirigente: ${c.second||'-'}</p><p>${c.phone1||''} ${c.instagram||''}</p>${current.profile==='admin'?`<div class="actions"><button class="mini" onclick="editC('${c.id}')">Editar</button><button class="danger" onclick="delC('${c.id}')">Excluir</button></div>`:''}</article>`).join(''):'<div class="empty">Nenhuma congregação.</div>'}
$('newCong').onclick=()=>{$('congForm').reset();$('cid').value='';$('congDlg').showModal()};$('congForm').onsubmit=e=>{e.preventDefault();let c={id:$('cid').value||id(),name:$('cname').value,address:$('caddress').value,pastor:$('cpastor').value,second:$('csecond').value,phone1:$('cphone1').value,phone2:$('cphone2').value,instagram:$('cinstagram').value};let i=data.congregations.findIndex(x=>x.id===c.id);i>=0?data.congregations[i]=c:data.congregations.push(c);save();$('congDlg').close();render()}
window.editC=i=>{let c=data.congregations.find(x=>x.id===i);$('cid').value=c.id;$('cname').value=c.name;$('caddress').value=c.address||'';$('cpastor').value=c.pastor||'';$('csecond').value=c.second||'';$('cphone1').value=c.phone1||'';$('cphone2').value=c.phone2||'';$('cinstagram').value=c.instagram||'';$('congDlg').showModal()};window.delC=i=>{if(confirm('Excluir congregação?')){data.congregations=data.congregations.filter(c=>c.id!==i);save();render()}}
$('newFest').onclick=()=>{$('festForm').reset();$('fid').value='';guests=[];fill($('fcong'));if(current.profile!=='admin')$('fcong').value=current.congregationId;renderGD();$('festDlg').showModal()}
$('addGuest').onclick=()=>{if(!$('gname').value)return toast('Informe o nome');guests.push({id:id(),type:$('gtype').value,name:$('gname').value,denomination:$('gden').value,church:$('gchurch').value,fee:n($('gfee').value),transport:n($('gtransport').value),hotel:n($('ghotel').value),food:n($('gfood').value),status:'pending',note:''});['gname','gden','gchurch','gfee','gtransport','ghotel','gfood'].forEach(x=>$(x).value='');renderGD()}
function renderGD(){$('guestDraft').innerHTML=guests.length?guests.map((g,i)=>`<div class="person"><h4>${g.type}: ${g.name}</h4><p>${g.denomination||'-'} • ${money(gt(g))}</p><button type="button" class="danger" onclick="rg(${i})">Remover</button></div>`).join(''):'Nenhum convidado.'}window.rg=i=>{guests.splice(i,1);renderGD()}
$('festForm').onsubmit=e=>{e.preventDefault();if(!guests.length)return toast('Adicione convidados');let fid=$('fid').value;let novo={id:fid||id(),congregationId:$('fcong').value,name:$('fname').value,start:$('fstart').value,end:$('fend').value,theme:$('ftheme').value,guests:guests,costs:{decoration:n($('decoration').value),sound:n($('sound').value),food:n($('food').value),ads:n($('ads').value),gifts:n($('gifts').value),other:n($('other').value)},status:'pending',note:fid?'Alterada e reenviada para aprovação':''};let ix=data.festivities.findIndex(x=>x.id===novo.id);if(ix>=0)data.festivities[ix]=novo;else data.festivities.push(novo);save();$('festDlg').close();render();toast(fid?'Festividade alterada e reenviada':'Enviada para aprovação')}
function fcard(f,adm){return `<article class="card"><h3>${f.name}</h3><p>${cname(f.congregationId)} • ${fmt(f.start)} a ${fmt(f.end)}</p><span class="status ${sc(f.status)}">${st(f.status)}</span>${f.guests.map(g=>`<div class="person"><h4>${g.type}: ${g.name}</h4><p>${g.denomination||'-'} • Valor total: ${money(gt(g))}</p><span class="status ${sc(g.status)}">${st(g.status)}</span>${g.note?`<p>Motivo: ${g.note}</p>`:''}${adm?`<div class="actions"><button class="approve" onclick="ag('${f.id}','${g.id}')">Aprovar</button><button class="reject" onclick="rgj('${f.id}','${g.id}')">Não aprovar</button></div>`:''}</div>`).join('')}<div class="finance"><div>Total solicitado<strong>${money(total(f))}</strong></div><div>Total aprovado<strong>${money(approvedTotal(f))}</strong></div></div>${f.note?`<p><b>Observação:</b> ${f.note}</p>`:''}${adm?`<div class="actions"><button class="approve" onclick="ae('${f.id}')">Aprovar evento</button><button class="reject" onclick="re('${f.id}')">Reprovar evento</button><button class="mini" onclick="editF('${f.id}')">Editar</button></div>`:`<div class="actions"><button class="mini" onclick="editF('${f.id}')">Editar festividade</button></div>`}</article>`}
window.editF=fi=>{let f=data.festivities.find(x=>x.id===fi);if(!f)return;$('festForm').reset();$('fid').value=f.id;fill($('fcong'));$('fcong').value=f.congregationId;$('fname').value=f.name||'';$('fstart').value=f.start||'';$('fend').value=f.end||'';$('ftheme').value=f.theme||'';$('decoration').value=f.costs?.decoration||'';$('sound').value=f.costs?.sound||'';$('food').value=f.costs?.food||'';$('ads').value=f.costs?.ads||'';$('gifts').value=f.costs?.gifts||'';$('other').value=f.costs?.other||'';guests=JSON.parse(JSON.stringify(f.guests||[]));guests.forEach(g=>{g.status='pending';g.note=''});renderGD();$('festDlg').showModal()}
function renderF(){$('festList').innerHTML=allowedF().length?allowedF().map(f=>fcard(f,false)).join(''):'<div class="empty">Nenhuma festividade.</div>'}function renderA(){$('approveList').innerHTML=current.profile==='admin'?(data.festivities.length?data.festivities.map(f=>fcard(f,true)).join(''):'<div class="empty">Nenhuma solicitação.</div>'):'Acesso restrito'}
window.ag=(fi,gi)=>{let f=data.festivities.find(x=>x.id===fi),g=f.guests.find(x=>x.id===gi);g.status='approved';g.note='';save();render()};window.rgj=(fi,gi)=>{let f=data.festivities.find(x=>x.id===fi),g=f.guests.find(x=>x.id===gi);g.status='rejected';g.note=prompt('Motivo:')||'Não aprovado';save();render()};window.ae=fi=>{let f=data.festivities.find(x=>x.id===fi);if(f.guests.some(g=>g.status==='pending'))return toast('Analise todos os convidados');f.status='approved';f.note=prompt('Observação opcional:')||'';save();render()};window.re=fi=>{let f=data.festivities.find(x=>x.id===fi);f.status='rejected';f.note=prompt('Motivo:')||'Evento não aprovado';save();render()}
function renderW(){let ws=current.profile==='admin'?data.workers:data.workers.filter(w=>w.congregationId===current.congregationId);$('workerList').innerHTML=ws.length?ws.map(w=>`<article class="card"><h3>${w.name}</h3><p>${w.role} • ${cname(w.congregationId)}</p></article>`).join(''):'<div class="empty">Nenhum obreiro.</div>'}
$('newWorker').onclick=()=>{$('workerForm').reset();fill($('wcong'));$('workerDlg').showModal()};$('workerForm').onsubmit=e=>{e.preventDefault();data.workers.push({id:id(),name:$('wname').value,role:$('wrole').value,congregationId:$('wcong').value,phone:$('wphone').value});save();$('workerDlg').close();render()}
function renderU(){}$('newUser').onclick=()=>{$('userForm').reset();fill($('ucong'));$('userDlg').showModal()};$('userForm').onsubmit=e=>{e.preventDefault();data.users.push({id:id(),name:$('uname').value,login:$('ulogin').value,password:$('upass').value,profile:$('uprofile').value,congregationId:$('ucong').value});save();$('userDlg').close();render()}
$('backup').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));a.download='backup-adsb.json';a.click()};$('reset').onclick=()=>{if(confirm('Apagar dados?')){localStorage.removeItem(K);location.reload()}}
